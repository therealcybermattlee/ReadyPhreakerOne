# /opt/wopr/wopr.env — sourced by the com.crunchwhistle.wopr LaunchDaemon. No secrets live here.
WOPR_BIND=127.0.0.1
WOPR_PORT=9092
WOPR_LOG_LEVEL=INFO
WOPR_OLLAMA_URL=http://127.0.0.1:11434
WOPR_MODEL=qwen3:8b
WOPR_WHISPER_MODEL=base.en
WOPR_STATS_PORT=9192
# Whisper weights were cached here at provisioning time; never touch the network at call time.
HF_HOME=/opt/wopr/hf
HF_HUB_OFFLINE=1
