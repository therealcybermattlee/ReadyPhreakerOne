<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.crunchwhistle.pf</string>
  <key>ProgramArguments</key>
  <array>
    <string>/sbin/pfctl</string>
    <string>-e</string>
    <string>-f</string>
    <string>/etc/pf-crunchwhistle.conf</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/opt/wopr/log/pf.log</string>
  <key>StandardErrorPath</key><string>/opt/wopr/log/pf.log</string>
</dict>
</plist>
