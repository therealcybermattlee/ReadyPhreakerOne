<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.crunchwhistle.asterisk</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/asterisk/sbin/asterisk</string>
    <string>-f</string>
    <string>-C</string><string>/opt/asterisk/etc/asterisk/asterisk.conf</string>
  </array>
  <key>UserName</key><string>__USER__</string>
  <key>GroupName</key><string>staff</string>
  <key>WorkingDirectory</key><string>/opt/asterisk</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/asterisk/sbin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>/opt/wopr/log/asterisk-launchd.log</string>
  <key>StandardErrorPath</key><string>/opt/wopr/log/asterisk-launchd.log</string>
</dict>
</plist>
